{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build (arduino-cli)",
      "type": "shell",
      "windows": {
        "command": "build.cmd"
      },
      "linux": {
        "command": "./build.sh"
      },
      "osx": {
        "command": "./build.sh"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Simulate (Wokwi CLI, needs WSL or token)",
      "type": "shell",
      "linux": {
        "command": "bash",
        "args": ["-c", "export WOKWI_CLI_TOKEN=$(grep WOKWI_CLI_TOKEN ~/.bashrc | cut -d= -f2); ~/.local/bin/wokwi-cli --timeout 12000 --expect-text ';190;928;24;100;24;194;1' --serial-log-file build/serial.log ."]
      },
      "osx": {
        "command": "bash",
        "args": ["-c", "~/.local/bin/wokwi-cli --timeout 12000 --expect-text ';190;928;24;100;24;194;1' --serial-log-file build/serial.log ."]
      },
      "dependsOn": ["Build (arduino-cli)"],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    }
  ]
}
